{
  "name": "dsh-offexplorer",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) plugin: kafka 浏览和管理工具，迁移offexplorer_rs功能.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/native.d.ts",
      "default": "./lib/native.js"
    },
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build:native": "cd rust && napi build --release --platform --js index.cjs --output-dir ../lib/native",
    "build:native:debug": "cd rust && napi build --platform --js index.cjs --output-dir ../lib/native",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "check:native": "node scripts/check-native.mjs",
    "check:plugin": "npm run build && node scripts/check-plugin.mjs",
    "check": "npm run check:native && npm run check:plugin",
    "test": "npm run check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "kafka",
    "rust",
    "napi"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
